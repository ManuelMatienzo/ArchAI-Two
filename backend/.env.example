# ==============================================================================
# ARCHAI BACKEND — CONFIGURACIÓN DE ENTORNO (.env)
# ==============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8000

# ── Base de Datos Supabase (PostgreSQL) ────────────────────────────────────────
# Opción 1: Conexión Directa (Reemplaza [PROJECT_REF] y [TU_PASSWORD])
SPRING_DATASOURCE_URL=jdbc:postgresql://db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=[TU_PASSWORD_DE_SUPABASE]
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Opción 2: Conexión por Connection Pooler (Sesión / Transacción en puerto 6543)
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.[PROJECT_REF]
# SPRING_DATASOURCE_PASSWORD=[TU_PASSWORD_DE_SUPABASE]

# ── Hibernate / JPA ──────────────────────────────────────────────────────────
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# ── CORS (Orígenes Permitidos) ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Propuestas CU-15/16/17: copiar a backend/.env.local (privado).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_WORKSPACE_ID=
ARCHAI_CLAUDE_FALLBACK_ENABLED=false
ARCHAI_AI_TEST_CONTROLS=false

# ── Notificaciones Push CU-23 (Firebase Cloud Messaging) ──────────────────────
# Activa el canal y apunta a la credencial del service account de Firebase.
# Acepta: ruta al .json, el JSON completo en una línea, o su contenido Base64.
ARCHAI_PUSH_FCM_HABILITADO=false
ARCHAI_PUSH_FCM_CREDENCIALES=
ARCHAI_PUSH_FCM_PROJECT_ID=
# Canal Expo Push (se usa solo si el móvil entrega un ExponentPushToken).
ARCHAI_PUSH_EXPO_HABILITADO=true
ARCHAI_PUSH_EXPO_URL=https://exp.host/--/api/v2/push/send
