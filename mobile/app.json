{
  "expo": {
    "name": "ArchAI Mobile",
    "slug": "archai-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#000020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.archai.mobile"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000020"
      },
      "package": "com.archai.mobile",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#38bdf8",
          "defaultChannel": "archai-critical"
        }
      ]
    ],
    "owner": "manuwfs-team",
    "extra": {
      "eas": {
        "projectId": "3bd58fcf-4228-4f47-8bd5-875dab00a610"
      },
      "archaiPush": {
        "channelId": "archai-critical",
        "expoProjectId": "3bd58fcf-4228-4f47-8bd5-875dab00a610"
      }
    }
  }
}
