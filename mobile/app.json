{
  "expo": {
    "name": "ArchAI Mobile",
    "slug": "archai-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#000020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.archai.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000020"
      },
      "package": "com.archai.mobile",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#38bdf8",
          "defaultChannel": "archai-critical",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "extra": {
      "archaiPush": {
        "expoProjectId": "",
        "androidChannelId": "archai-critical"
      }
    }
  }
}
