# Copiar a .env en la raíz de ArchAI. Este ejemplo no contiene secretos.
PORT=8000

# SQL conserva cuentas, proyectos, versiones y cola documental.
SPRING_DATASOURCE_URL=jdbc:h2:file:./.archai/localdb;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_JPA_DDL_AUTO=update

# Para Supabase/PostgreSQL, sustituir las variables SQL anteriores.
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Obligatorio para las sesiones NoSQL. Pegar la URI privada de MongoDB Atlas.
# Alternativa local: mongodb://127.0.0.1:27017/archai
SPRING_DATA_MONGODB_URI=

# Opcional para despliegues; en local se genera en .archai/jwt.key.
ARCHAI_JWT_SECRETO=

# Claves y política de IA: backend/.env.local desde backend/.env.example.
